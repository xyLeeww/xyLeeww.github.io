---
import DocsLayout from '../layouts/DocsLayout.astro';
import { render } from 'astro:content';
import { sectionOf, navTitle, entryUrl, type DocEntry, type DocSpace } from '../data/docs';

interface Props {
  space: DocSpace;
  entry: DocEntry;
  prev: DocEntry | null;
  next: DocEntry | null;
}

const { space, entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const section = sectionOf(space, entry);
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const docsUrl = (id: string) => entryUrl(space, id);
---

<DocsLayout title={`${d.title} | ${space.brand}`} space={space} sidebar currentId={entry.id}>
  <div class="ddoc">
    <article class="ddoc-main">
      <nav class="dcrumbs" aria-label="面包屑">
        <a href={`${space.base}/`} aria-label="首页">
          <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M10 19v-5h4v5c0 .55.45 1 1 1h3c.55 0 1-.45 1-1v-7h1.7c.46 0 .68-.57.33-.87L12.67 3.6a1 1 0 0 0-1.34 0l-8.36 7.53c-.34.3-.13.87.33.87H5v7c0 .55.45 1 1 1h3c.55 0 1-.45 1-1z" /></svg>
        </a>
        {section && <><span class="sep">›</span><span>{section.title}</span></>}
        <span class="sep">›</span>
        <span class="dcrumb-current">{navTitle(entry)}</span>
      </nav>

      <h1 class="ddoc-title">{d.title}</h1>
      {d.source && (
        <p class="ddoc-source">
          {d.kind === 'translation' ? '原文' : '参考'}:<a href={d.source} target="_blank" rel="noopener">{d.sourceTitle ?? d.source}</a>
          {d.license && <span> · 许可:{d.license}</span>}
        </p>
      )}

      <div class="markdown">
        <Content />
      </div>

      <p class="ddoc-note">
        {d.kind === 'translation'
          ? '本页为中文翻译,版权与许可遵循原文;译文如有错漏,以原文为准。'
          : '本页为原创学习笔记,原始资料见文中链接。'}
      </p>

      <nav class="dpager" aria-label="翻页">
        {prev ? (
          <a class="dpager-link" href={docsUrl(prev.id)}>
            <span class="dpager-sub">上一页</span>
            <span class="dpager-label">« {navTitle(prev)}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="dpager-link next" href={docsUrl(next.id)}>
            <span class="dpager-sub">下一页</span>
            <span class="dpager-label">{navTitle(next)} »</span>
          </a>
        ) : <span />}
      </nav>
    </article>

    {toc.length > 1 && (
      <aside class="dtoc">
        <p class="dtoc-title">本页目录</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  <script is:inline type="module">
    // Docusaurus-style word-wrap and copy icon buttons on code blocks.
    const icons = {
      wrap: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z"/></svg>',
      copy: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1z"/></svg>',
      done: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 7 9 19l-5.5-5.5 1.41-1.41L9 16.17 19.59 5.59 21 7z"/></svg>',
    };
    const makeButton = (title, icon) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.title = title;
      b.setAttribute('aria-label', title);
      b.innerHTML = icon;
      return b;
    };
    document.querySelectorAll('.markdown pre.astro-code:not([data-language="mermaid"])').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'dcode';
      pre.replaceWith(wrap);
      wrap.appendChild(pre);
      const btns = document.createElement('div');
      btns.className = 'dcode-btns';

      const wrapBtn = makeButton('切换自动换行', icons.wrap);
      wrapBtn.addEventListener('click', () => wrapBtn.classList.toggle('on', pre.classList.toggle('dwrap')));

      const copyBtn = makeButton('复制', icons.copy);
      copyBtn.addEventListener('click', async () => {
        // Copy the code as it should look after the change: skip lines marked for deletion.
        const lines = [...pre.querySelectorAll('.line')];
        const text = lines.length
          ? lines.filter((l) => !l.classList.contains('deleted')).map((l) => l.textContent).join('\n')
          : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.innerHTML = icons.done;
          copyBtn.title = '已复制';
        } catch {
          copyBtn.title = '复制失败';
        }
        setTimeout(() => { copyBtn.innerHTML = icons.copy; copyBtn.title = '复制'; }, 1500);
      });

      btns.append(wrapBtn, copyBtn);
      wrap.appendChild(btns);
    });

    // Highlight the heading currently in view in the right-hand TOC.
    const links = [...document.querySelectorAll('.dtoc a')];
    if (links.length) {
      const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean);
      const update = () => {
        let current = targets[0];
        for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t;
        links.forEach((a) => a.classList.toggle('active', current && decodeURIComponent(a.hash.slice(1)) === current.id));
      };
      addEventListener('scroll', update, { passive: true });
      update();
    }

    // Render ```mermaid code blocks as diagrams; leave them as code if the CDN is unreachable.
    const blocks = document.querySelectorAll('.markdown pre[data-language="mermaid"]');
    if (blocks.length) {
      try {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid.initialize({ startOnLoad: false, theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default' });
        const nodes = [...blocks].map((pre) => {
          const div = document.createElement('div');
          div.className = 'mermaid dmermaid';
          div.textContent = pre.textContent;
          pre.replaceWith(div);
          return div;
        });
        await mermaid.run({ nodes });
      } catch (e) {
        console.warn('mermaid render failed', e);
      }
    }
  </script>
</DocsLayout>
