---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';
import { groupBySection, entryUrl } from '../../data/docs';
import { linuxSpace } from '../../data/linux';

const groups = groupBySection(linuxSpace, await getCollection('linuxdrivers'));
const first = groups[0]?.entries[0];
const docsUrl = (id: string) => entryUrl(linuxSpace, id);
const startOf = (key: string) => groups.find((g) => g.section.key === key)?.entries[0];
const entryOf = (id: string) => groups.flatMap((g) => g.entries).find((e) => e.id === id);

const features = [
  {
    title: '一台电脑搭好实验环境',
    text: 'WSL2 + QEMU/KVM + 自己编译的内核:驱动写崩了只重启一台小虚拟机,还能用 gdb 单步调内核。',
    href: entryOf('00-guide/03-environment') ?? first,
    icon: 'M2 4h20v16H2V4zm2 2v12h16V6H4zm2.5 2.5L10 12l-3.5 3.5-1.4-1.4L7.2 12 5.1 9.9l1.4-1.4zM11 15h7v2h-7v-2z',
  },
  {
    title: '边写边学的动手课程',
    text: '从 hello 模块开始,逐步写字符设备、PCI 驱动、中断和 DMA,每一课都能在 QEMU 里跑起来。',
    href: startOf('01-lessons'),
    icon: 'M12 2 2 7l10 5 10-5-10-5zm-8 9.5 8 4 8-4V14l-8 4-8-4v-2.5zm0 5 8 4 8-4V19l-8 4-8-4v-2.5z',
  },
  {
    title: '原创学习笔记',
    text: '开发环境的三层结构、QEMU edu 设备驱动导读,以及一路踩过的坑。',
    href: startOf('02-notes'),
    icon: 'M6 2h9l5 5v15H6zm8 1.5V8h4.5zM8 12h8v2H8zm0 4h8v2H8z',
  },
];
---

<DocsLayout title="Linux 驱动开发学习笔记 | Linux 驱动开发" space={linuxSpace}>
  <header class="dhero">
    <h1>Linux 驱动开发学习笔记</h1>
    <p>WSL2 · QEMU/KVM · 内核模块 · PCI 驱动 · By Ava Li</p>
    {first && <a class="dbtn" href={docsUrl(first.id)}>开始阅读</a>}
  </header>

  <section class="dfeatures">
    {features.map((f) => (
      <div class="dfeature">
        <svg viewBox="0 0 24 24" width="96" height="96" aria-hidden="true"><path fill="currentColor" d={f.icon} /></svg>
        <h3>{f.href ? <a href={docsUrl(f.href.id)}>{f.title}</a> : f.title}</h3>
        <p>{f.text}</p>
      </div>
    ))}
  </section>
</DocsLayout>
