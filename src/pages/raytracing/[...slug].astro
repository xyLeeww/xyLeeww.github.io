---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RtToc from '../../components/RtToc.astro';
import { getCollection, render } from 'astro:content';
import { sortEntries, sectionOf, entryUrl } from '../../data/raytracing';

export async function getStaticPaths() {
  const entries = sortEntries(await getCollection('raytracing'));
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null, entries },
  }));
}

const { entry, prev, next, entries } = Astro.props;
const { Content } = await render(entry);
const section = sectionOf(entry);
const d = entry.data;
---

<BaseLayout title={`${d.title} - 光线追踪中文资料`}>
  <Fragment slot="nav">
    <li><a href="/">← Home</a></li>
  </Fragment>
  <RtToc slot="sidebar-extra" entries={entries} currentId={entry.id} />

  <a href="/raytracing/" class="back-link">← 光线追踪中文资料</a>

  <article>
    <div class="note-header">
      {section && <p class="rt-section-label">{section.title}</p>}
      <h1>{d.title}</h1>
      <div class="note-meta">
        <span class="tag">{d.kind === 'translation' ? '翻译' : '原创笔记'}</span>
        {d.source && (
          <span>
            原文:<a href={d.source} target="_blank" rel="noopener">{d.sourceTitle ?? d.source}</a>
          </span>
        )}
      </div>
    </div>

    <div class="note-content">
      <Content />
    </div>

    <p class="rt-license">
      {d.kind === 'translation'
        ? `本页为中文翻译,版权与许可遵循原文${d.license ? `(${d.license})` : ''};译文如有错漏,以原文为准。`
        : '本页为原创学习笔记,依据公开资料用自己的话整理,原始资料见文中链接。'}
    </p>

    <nav class="rt-pager">
      {prev ? <a class="prev" href={entryUrl(prev)}><small>上一页</small>{prev.data.title}</a> : <span />}
      {next ? <a class="next" href={entryUrl(next)}><small>下一页</small>{next.data.title}</a> : <span />}
    </nav>
  </article>

  <script is:inline type="module">
    // Render ```mermaid code blocks as diagrams; leave them as code if the CDN is unreachable.
    const blocks = document.querySelectorAll('.note-content pre[data-language="mermaid"]');
    if (blocks.length) {
      try {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid.initialize({ startOnLoad: false, theme: 'default' });
        const nodes = [...blocks].map((pre) => {
          const div = document.createElement('div');
          div.className = 'mermaid rt-mermaid';
          div.textContent = pre.textContent;
          pre.replaceWith(div);
          return div;
        });
        await mermaid.run({ nodes });
      } catch (e) {
        console.warn('mermaid render failed', e);
      }
    }
  </script>
</BaseLayout>
