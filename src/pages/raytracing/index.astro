---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RtToc from '../../components/RtToc.astro';
import { getCollection } from 'astro:content';
import { groupBySection, entryUrl } from '../../data/raytracing';

const entries = await getCollection('raytracing');
const groups = groupBySection(entries);
const first = groups[0]?.entries[0];
---

<BaseLayout title="光线追踪中文资料 - Ava Li">
  <Fragment slot="nav">
    <li><a href="/">← Home</a></li>
  </Fragment>
  <RtToc slot="sidebar-extra" entries={entries} />

  <section class="rt-hero">
    <h2 class="section-title">光线追踪中文资料</h2>
    <p class="rt-hero-sub">简单易懂的中文翻译 + 学习笔记</p>
    <p>
      这里收集了入门光线追踪(Ray Tracing)最常用的几份资料的中文版:从 CPU 上手写光线追踪器的
      《Ray Tracing in One Weekend》,到 BVH 加速结构,再到 Vulkan 硬件光线追踪。
      许可允许的资料做完整翻译,其余资料以原创学习笔记的形式整理,并附原文链接。
    </p>
    {first && (
      <p>
        <a class="rt-start" href={entryUrl(first)}>开始阅读 →</a>
        <a class="rt-start rt-alt" href="/rt-docs/">文档风格版本 →</a>
      </p>
    )}
  </section>

  {groups.map(({ section, entries }) => (
    <section class="rt-group">
      <h3>{section.title}</h3>
      <p class="post-desc">{section.summary}</p>
      <ul class="rt-list">
        {entries.map((e) => (
          <li><a href={entryUrl(e)}>{e.data.title}</a></li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
